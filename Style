/* ============================================
   CSS for Beautiful Birthday Surprise Website
   Customizable Variables & Animations
   ============================================ */

/* Root Variables - EASY TO CUSTOMIZE */
:root {
    /* Colors - Soft Pastel Theme */
    --primary-color: #ff6b9d;      /* Bright Pink */
    --secondary-color: #c44569;    /* Deep Pink */
    --accent-color: #ffa502;       /* Warm Orange */
    --light-bg: #ffeef6;           /* Light Pink Background */
    --white: #ffffff;
    --text-dark: #4a4a4a;
    --text-light: #7a7a7a;
    
    /* Gradients */
    --gradient-main: linear-gradient(135deg, #ffeef6 0%, #f5e6ff 50%, #ffe6f0 100%);
    --gradient-accent: linear-gradient(135deg, #ff6b9d 0%, #c44569 100%);
    
    /* Spacing & Sizing */
    --transition-speed: 0.6s ease-in-out;
    --border-radius: 20px;
}

/* ============================================
   GLOBAL STYLES
   ============================================ */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: 'Poppins', sans-serif;
    background: var(--gradient-main);
    color: var(--text-dark);
    overflow: hidden;
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
}

/* ============================================
   SCREENS
   ============================================ */

.screen {
    display: none;
    position: absolute;
    width: 100%;
    height: 100vh;
    padding: 40px 20px;
    animation: fadeIn var(--transition-speed);
    z-index: 1;
}

.screen.active {
    display: flex;
    align-items: center;
    justify-content: center;
}

.fade-in {
    animation: fadeInInitial 0.8s ease-in-out;
}

@keyframes fadeIn {
    from {
        opacity: 0;
        transform: translateY(20px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@keyframes fadeInInitial {
    from {
        opacity: 0;
    }
    to {
        opacity: 1;
    }
}

/* ============================================
   SCREEN 1: OPENING SCREEN
   ============================================ */

.opening-container {
    text-align: center;
    position: relative;
    z-index: 2;
}

.animated-hearts {
    font-size: 4rem;
    margin-bottom: 30px;
    display: flex;
    justify-content: center;
    gap: 20px;
}

.heart {
    display: inline-block;
    animation: heartBeat 1.2s infinite;
}

.heart:nth-child(2) {
    animation-delay: 0.2s;
}

.heart:nth-child(3) {
    animation-delay: 0.4s;
}

@keyframes heartBeat {
    0%, 100% {
        transform: scale(1);
    }
    25% {
        transform: scale(1.3);
    }
    50% {
        transform: scale(1);
    }
}

.opening-text {
    font-family: 'Dancing Script', cursive;
    font-size: clamp(2.5rem, 8vw, 4rem);
    color: var(--primary-color);
    margin-bottom: 10px;
    font-weight: 700;
    text-shadow: 2px 2px 4px rgba(255, 107, 157, 0.2);
}

.opening-subtext {
    font-size: 1.2rem;
    color: var(--text-light);
    margin-bottom: 40px;
    font-weight: 300;
}

.btn-primary {
    background: var(--gradient-accent);
    color: white;
    border: none;
    padding: 15px 40px;
    font-size: 1.1rem;
    border-radius: 50px;
    cursor: pointer;
    font-weight: 600;
    transition: all 0.3s ease;
    box-shadow: 0 10px 30px rgba(255, 107, 157, 0.3);
    font-family: 'Poppins', sans-serif;
}

.btn-primary:hover {
    transform: translateY(-3px);
    box-shadow: 0 15px 40px rgba(255, 107, 157, 0.4);
}

.btn-primary:active {
    transform: translateY(-1px);
}

.glowing-circle {
    position: absolute;
    width: 300px;
    height: 300px;
    background: radial-gradient(circle, rgba(255, 107, 157, 0.1) 0%, transparent 70%);
    border-radius: 50%;
    animation: pulse 3s infinite;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: -1;
}

@keyframes pulse {
    0%, 100% {
        transform: translate(-50%, -50%) scale(1);
        opacity: 0.5;
    }
    50% {
        transform: translate(-50%, -50%) scale(1.2);
        opacity: 0.8;
    }
}

/* ============================================
   SCREEN 2: SURPRISE SCREEN
   ============================================ */

.surprise-container {
    text-align: center;
    position: relative;
    width: 100%;
}

.surprise-text {
    font-family: 'Dancing Script', cursive;
    font-size: clamp(2rem, 10vw, 3.5rem);
    color: var(--primary-color);
    margin-bottom: 30px;
    font-weight: 700;
    animation: zoomIn 0.8s ease-out;
}

@keyframes zoomIn {
    from {
        opacity: 0;
        transform: scale(0.8);
    }
    to {
        opacity: 1;
        transform: scale(1);
    }
}

.celebration-emoji {
    font-size: 3rem;
    margin-bottom: 40px;
    animation: bounce 1s infinite;
}

@keyframes bounce {
    0%, 100% {
        transform: translateY(0);
    }
    50% {
        transform: translateY(-20px);
    }
}

.btn-secondary {
    background: var(--primary-color);
    color: white;
    border: none;
    padding: 15px 40px;
    font-size: 1.1rem;
    border-radius: 50px;
    cursor: pointer;
    font-weight: 600;
    transition: all 0.3s ease;
    box-shadow: 0 10px 30px rgba(255, 107, 157, 0.3);
    font-family: 'Poppins', sans-serif;
}

.btn-secondary:hover {
    transform: translateY(-3px) scale(1.05);
    box-shadow: 0 15px 40px rgba(255, 107, 157, 0.4);
}

.btn-secondary:active {
    transform: translateY(-1px);
}

/* Confetti Container */
.confetti-container {
    position: absolute;
    width: 100%;
    height: 100%;
    pointer-events: none;
    overflow: hidden;
}

.confetti {
    position: absolute;
    width: 10px;
    height: 10px;
    background-color: #ff6b9d;
    animation: confettiFall 3s infinite;
}

@keyframes confettiFall {
    0% {
        transform: translateY(-10vh) rotate(0deg);
        opacity: 1;
    }
    100% {
        transform: translateY(100vh) rotate(360deg);
        opacity: 0;
    }
}

/* ============================================
   SCREEN 3: PHOTO GALLERY
   ============================================ */

.gallery-container {
    width: 100%;
    max-width: 600px;
    text-align: center;
}

.gallery-title {
    font-family: 'Dancing Script', cursive;
    font-size: clamp(1.8rem, 6vw, 2.5rem);
    color: var(--primary-color);
    margin-bottom: 30px;
    font-weight: 700;
}

.gallery-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 4/3;
    border-radius: var(--border-radius);
    overflow: hidden;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.15);
    background: var(--white);
}

.gallery-slide {
    display: none;
    width: 100%;
    height: 100%;
    animation: fadeIn var(--transition-speed);
}

.gallery-slide.active {
    display: flex;
    align-items: center;
    justify-content: center;
}

.gallery-slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    animation: zoomInImage 0.6s ease-out;
}

@keyframes zoomInImage {
    from {
        transform: scale(1.05);
        opacity: 0;
    }
    to {
        transform: scale(1);
        opacity: 1;
    }
}

.fade {
    animation: fadeIn var(--transition-speed);
}

/* Gallery Navigation */
.gallery-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    font-size: 2rem;
    color: white;
    background: rgba(0, 0, 0, 0.5);
    border: none;
    padding: 10px 15px;
    border-radius: 50%;
    cursor: pointer;
    transition: all 0.3s ease;
    z-index: 10;
    user-select: none;
}

.gallery-nav:hover {
    background: rgba(0, 0, 0, 0.8);
    transform: translateY(-50%) scale(1.2);
}

.gallery-nav.prev {
    left: 15px;
}

.gallery-nav.next {
    right: 15px;
}

/* Gallery Indicators */
.gallery-indicators {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin-top: 20px;
    flex-wrap: wrap;
}

.indicator {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: rgba(255, 107, 157, 0.3);
    cursor: pointer;
    transition: all 0.3s ease;
}

.indicator.active {
    background: var(--primary-color);
    transform: scale(1.3);
}

/* ============================================
   SCREEN 4: MESSAGE SCREEN
   ============================================ */

.message-container {
    width: 100%;
    max-width: 700px;
    text-align: center;
}

.message-title {
    font-family: 'Dancing Script', cursive;
    font-size: clamp(1.8rem, 6vw, 2.5rem);
    color: var(--primary-color);
    margin-bottom: 30px;
    font-weight: 700;
}

.message-box {
    background: var(--white);
    border: 3px solid var(--primary-color);
    border-radius: var(--border-radius);
    padding: 40px;
    box-shadow: 0 15px 40px rgba(255, 107, 157, 0.2);
    min-height: 300px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.message-text {
    font-size: clamp(1rem, 3vw, 1.3rem);
    line-height: 1.8;
    color: var(--text-dark);
    font-weight: 500;
    white-space: pre-line;
}

.decorative-elements {
    display: flex;
    justify-content: center;
    gap: 30px;
    margin-top: 30px;
    font-size: 2rem;
}

.decoration {
    animation: float 3s ease-in-out infinite;
}

.decoration:nth-child(2) {
    animation-delay: 0.5s;
}

@keyframes float {
    0%, 100% {
        transform: translateY(0px);
    }
    50% {
        transform: translateY(-15px);
    }
}

/* ============================================
   SCREEN 5: MUSIC SCREEN
   ============================================ */

.music-container {
    text-align: center;
    width: 100%;
    max-width: 500px;
}

.music-title {
    font-family: 'Dancing Script', cursive;
    font-size: clamp(1.8rem, 6vw, 2.5rem);
    color: var(--primary-color);
    margin-bottom: 40px;
    font-weight: 700;
}

.music-player {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    margin-bottom: 40px;
}

.music-btn {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    border: none;
    background: var(--gradient-accent);
    font-size: 3rem;
    cursor: pointer;
    box-shadow: 0 15px 40px rgba(255, 107, 157, 0.3);
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
}

.music-btn:hover {
    transform: scale(1.1);
    box-shadow: 0 20px 50px rgba(255, 107, 157, 0.4);
}

.music-btn:active {
    transform: scale(0.95);
}

.music-icon {
    display: inline-block;
    animation: musicBounce 0.6s infinite;
}

@keyframes musicBounce {
    0%, 100% {
        transform: translateY(0);
    }
    50% {
        transform: translateY(-10px);
    }
}

.music-text {
    font-size: 1.1rem;
    color: var(--text-light);
    font-weight: 500;
}

/* Progress Bar */
.progress-bar {
    width: 100%;
    height: 6px;
    background: rgba(255, 107, 157, 0.2);
    border-radius: 10px;
    margin-bottom: 15px;
    overflow: hidden;
}

.progress {
    height: 100%;
    background: var(--primary-color);
    border-radius: 10px;
    width: 0%;
    transition: width 0.1s linear;
}

/* Music Info */
.music-info {
    display: flex;
    justify-content: space-between;
    font-size: 0.9rem;
    color: var(--text-light);
    font-weight: 500;
}

/* ============================================
   SCREEN 6: FINAL SCREEN
   ============================================ */

.final-container {
    text-align: center;
    position: relative;
    width: 100%;
}

.final-text {
    font-family: 'Dancing Script', cursive;
    font-size: clamp(2rem, 10vw, 3.5rem);
    color: var(--primary-color);
    margin-bottom: 30px;
    font-weight: 700;
    animation: fadeInScale 1s ease-out;
}

@keyframes fadeInScale {
    from {
        opacity: 0;
        transform: scale(0.9);
    }
    to {
        opacity: 1;
        transform: scale(1);
    }
}

.floating-hearts {
    position: relative;
    height: 300px;
    margin: 30px 0;
    display: flex;
    align-items: center;
    justify-content: center;
}

.heart-float {
    position: absolute;
    font-size: 2rem;
    animation: floatUp 4s infinite;
}

.heart-float:nth-child(1) {
    left: 20%;
    animation-delay: 0s;
}

.heart-float:nth-child(2) {
    left: 40%;
    animation-delay: 0.5s;
}

.heart-float:nth-child(3) {
    left: 50%;
    animation-delay: 1s;
}

.heart-float:nth-child(4) {
    left: 60%;
    animation-delay: 1.5s;
}

.heart-float:nth-child(5) {
    left: 80%;
    animation-delay: 2s;
}

@keyframes floatUp {
    0% {
        opacity: 0;
        transform: translateY(0) scale(0.5);
    }
    10% {
        opacity: 1;
    }
    90% {
        opacity: 1;
    }
    100% {
        opacity: 0;
        transform: translateY(-300px) scale(1.5);
    }
}

.final-text-small {
    font-size: 1.3rem;
    color: var(--text-light);
    margin-top: 30px;
    font-weight: 500;
}

/* ============================================
   NAVIGATION CONTROLS
   ============================================ */

.navigation-controls {
    position: fixed;
    bottom: 30px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 20px;
    z-index: 100;
    background: rgba(255, 255, 255, 0.95);
    padding: 15px 30px;
    border-radius: 50px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
}

.nav-btn {
    background: var(--primary-color);
    color: white;
    border: none;
    padding: 10px 20px;
    border-radius: 25px;
    cursor: pointer;
    font-weight: 600;
    transition: all 0.3s ease;
    font-family: 'Poppins', sans-serif;
    font-size: 0.95rem;
}

.nav-btn:hover {
    background: var(--secondary-color);
    transform: translateY(-2px);
}

.nav-btn:active {
    transform: translateY(0);
}

.screen-counter {
    font-weight: 600;
    color: var(--text-dark);
    min-width: 50px;
    font-size: 0.95rem;
}

/* Restart Button */
.restart-btn {
    position: fixed;
    top: 20px;
    right: 20px;
    background: var(--primary-color);
    color: white;
    border: none;
    padding: 10px 20px;
    border-radius: 25px;
    cursor: pointer;
    font-weight: 600;
    transition: all 0.3s ease;
    z-index: 100;
    font-family: 'Poppins', sans-serif;
}

.restart-btn:hover {
    background: var(--secondary-color);
    transform: rotate(90deg) scale(1.1);
}

/* ============================================
   RESPONSIVE DESIGN
   ============================================ */

/* Tablets */
@media (max-width: 768px) {
    .screen {
        padding: 30px 15px;
    }

    .opening-text {
        font-size: 2.2rem;
    }

    .surprise-text {
        font-size: 1.8rem;
    }

    .btn-primary, .btn-secondary {
        padding: 12px 30px;
        font-size: 1rem;
    }

    .message-box {
        padding: 30px 20px;
        min-height: 250px;
    }

    .message-text {
        font-size: 1.05rem;
    }

    .navigation-controls {
        bottom: 20px;
        padding: 12px 20px;
        gap: 15px;
    }

    .nav-btn {
        padding: 8px 16px;
        font-size: 0.85rem;
    }

    .restart-btn {
        top: 15px;
        right: 15px;
        padding: 8px 16px;
        font-size: 0.9rem;
    }

    .animated-hearts {
        font-size: 2.5rem;
        gap: 15px;
    }

    .heart {
        display: inline-block;
    }

    .gallery-nav {
        padding: 8px 12px;
        font-size: 1.5rem;
    }

    .music-btn {
        width: 100px;
        height: 100px;
        font-size: 2.5rem;
    }
}

/* Mobile Phones */
@media (max-width: 480px) {
    .screen {
        padding: 20px 15px;
    }

    .opening-text {
        font-size: 1.8rem;
        margin-bottom: 5px;
    }

    .opening-subtext {
        font-size: 1rem;
        margin-bottom: 25px;
    }

    .btn-primary, .btn-secondary {
        padding: 12px 25px;
        font-size: 0.95rem;
    }

    .surprise-text {
        font-size: 1.5rem;
        margin-bottom: 20px;
    }

    .celebration-emoji {
        font-size: 2rem;
        margin-bottom: 30px;
    }

    .gallery-container {
        max-width: 100%;
    }

    .gallery-title {
        font-size: 1.5rem;
        margin-bottom: 20px;
    }

    .gallery-wrapper {
        aspect-ratio: 16/12;
    }

    .gallery-nav {
        padding: 6px 10px;
        font-size: 1.2rem;
    }

    .gallery-nav.prev {
        left: 10px;
    }

    .gallery-nav.next {
        right: 10px;
    }

    .indicator {
        width: 10px;
        height: 10px;
    }

    .message-container {
        max-width: 100%;
    }

    .message-title {
        font-size: 1.5rem;
        margin-bottom: 20px;
    }

    .message-box {
        padding: 20px 15px;
        min-height: 200px;
        border: 2px solid var(--primary-color);
    }

    .message-text {
        font-size: 0.95rem;
        line-height: 1.6;
    }

    .decorative-elements {
        gap: 20px;
        margin-top: 20px;
        font-size: 1.5rem;
    }

    .music-container {
        max-width: 100%;
    }

    .music-title {
        font-size: 1.5rem;
        margin-bottom: 30px;
    }

    .music-btn {
        width: 90px;
        height: 90px;
        font-size: 2rem;
    }

    .music-text {
        font-size: 1rem;
    }

    .final-text {
        font-size: 1.5rem;
        margin-bottom: 20px;
    }

    .floating-hearts {
        height: 200px;
        margin: 20px 0;
    }

    .heart-float {
        font-size: 1.5rem;
    }

    .final-text-small {
        font-size: 1.05rem;
        margin-top: 20px;
    }

    .navigation-controls {
        bottom: 15px;
        left: 50%;
        transform: translateX(-50%);
        padding: 10px 15px;
        gap: 10px;
    }

    .nav-btn {
        padding: 8px 12px;
        font-size: 0.8rem;
    }

    .screen-counter {
        font-size: 0.8rem;
        min-width: 40px;
    }

    .restart-btn {
        top: 10px;
        right: 10px;
        padding: 8px 12px;
        font-size: 0.8rem;
    }

    .animated-hearts {
        font-size: 2rem;
        gap: 10px;
        margin-bottom: 20px;
    }

    .glowing-circle {
        width: 200px;
        height: 200px;
    }
}

/* Extra Small Phones */
@media (max-width: 360px) {
    .opening-text {
        font-size: 1.5rem;
    }

    .surprise-text {
        font-size: 1.3rem;
    }

    .btn-primary, .btn-secondary {
        padding: 10px 20px;
        font-size: 0.9rem;
    }

    .message-box {
        padding: 15px 10px;
        min-height: 180px;
    }

    .message-text {
        font-size: 0.9rem;
    }

    .navigation-controls {
        padding: 8px 12px;
        gap: 8px;
    }

    .nav-btn {
        padding: 6px 10px;
        font-size: 0.75rem;
    }

    .final-text {
        font-size: 1.3rem;
    }
}

/* ============================================
   UTILITY CLASSES
   ============================================ */

.fade {
    animation: fadeIn var(--transition-speed);
}

.slide-in {
    animation: slideIn var(--transition-speed);
}

@keyframes slideIn {
    from {
        opacity: 0;
        transform: translateX(50px);
    }
    to {
        opacity: 1;
        transform: translateX(0);
    }
}

/* ============================================
   SCROLLBAR STYLING
   ============================================ */

::-webkit-scrollbar {
    width: 8px;
}

::-webkit-scrollbar-track {
    background: rgba(255, 107, 157, 0.1);
}

::-webkit-scrollbar-thumb {
    background: var(--primary-color);
    border-radius: 10px;
}

::-webkit-scrollbar-thumb:hover {
    background: var(--secondary-color);
}
